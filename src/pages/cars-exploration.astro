---
import cars from "../data/cars.json";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Cars" active="cars">
  <main class="page">
    <h1>Cars</h1>

    <p class="intro">
      Explorez les voitures en filtrant les données par année, cylindres et puissance.
    </p>

    <section class="filters">
      <div class="filter">
        <label for="year">Année</label>
        <select id="year">
          <option value="">Toutes</option>
          {
            [...new Set(cars.map((car) => car.year))]
              .sort()
              .map((year) => (
                <option value={year}>{year}</option>
              ))
          }
        </select>
      </div>

      <div class="filter">
        <label for="cylinders">Cylindres</label>
        <select id="cylinders">
          <option value="">Tous</option>
          {
            [...new Set(cars.map((car) => car.cylinders))]
              .sort((a, b) => a - b)
              .map((cylinders) => (
                <option value={cylinders}>{cylinders}</option>
              ))
          }
        </select>
      </div>

      <div class="filter">
        <label for="power">Puissance</label>
        <select id="power">
          <option value="">Toutes</option>
          {
            [...new Set(cars.map((car) => car["power (hp)"]))]
              .sort((a, b) => a - b)
              .map((power) => (
                <option value={power}>{power} hp</option>
              ))
          }
        </select>
      </div>
    </section>

    <p id="count"></p>

    <div id="plot"></div>
  </main>
</Layout>

<script>
  import * as Plot from "@observablehq/plot";
  import cars from "../data/cars.json";

  const selectYear =
    document.querySelector("#year") as HTMLSelectElement;

  const selectCylinders =
    document.querySelector("#cylinders") as HTMLSelectElement;

  const selectPower =
    document.querySelector("#power") as HTMLSelectElement;

  const plotContainer =
    document.querySelector("#plot") as HTMLDivElement;

  const count =
    document.querySelector("#count") as HTMLParagraphElement;

  function renderPlot() {
    const year = selectYear.value;
    const cylinders = selectCylinders.value;
    const power = selectPower.value;

    const filteredCars = cars.filter((car) => {
      return (
        (year === "" || car.year.toString() === year) &&
        (cylinders === "" || car.cylinders.toString() === cylinders) &&
        (power === "" || car["power (hp)"].toString() === power)
      );
    });

    plotContainer.innerHTML = "";

    const plot = Plot.plot({
      grid: true,
      marks: [
        Plot.dot(filteredCars, {
          x: "weight (lb)",
          y: "power (hp)",
          fill: "cylinders",
          r: 4,
          fillOpacity: 0.7,
          title: (car) =>
            `${car.name} · ${car.year} · ${car.cylinders} cylindres · ${car["power (hp)"]} hp`,
        }),
      ],
      x: {
        label: "Poids (lb)",
      },
      y: {
        label: "Puissance (hp)",
      },
    });

    plotContainer.append(plot);

    count.textContent = `${filteredCars.length} voiture(s)`;
  }

  selectYear.addEventListener("change", renderPlot);
  selectCylinders.addEventListener("change", renderPlot);
  selectPower.addEventListener("change", renderPlot);

  renderPlot();
</script>

<style>
  .page {
    max-width: 1200px;
    margin-left: 228px;
    padding: 50px;
    box-sizing: border-box;
  }

  h1 {
    margin: 0;
    font-size: 42px;
  }

  .intro {
    margin-top: 8px;
    color: #666;
  }

  .filters {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 35px 0 20px;
  }

  .filter {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  select {
    height: 42px;
    padding: 0 12px;
    border: 1px solid #d6d6d6;
    border-radius: 4px;
    background: white;
    font-size: 14px;
  }

  #count {
    color: #666;
    font-size: 14px;
  }

  #plot {
    margin-top: 25px;
    min-height: 450px;
  }

  @media (max-width: 800px) {
    .page {
      margin-left: 0;
      padding: 30px 20px;
    }

    .filters {
      grid-template-columns: 1fr;
    }
  }
</style>